{
    "name": "krill-script-marco",
    "displayName": "Krill Script Marco",
    "description": "base support for Krill Script Marco",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.106.1"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "ksm",
                "aliases": ["KSM", "ksm"],
                "extensions": [".ksm"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ksm",
                "scopeName": "source.ksm",
                "path": "./syntaxes/ksm.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "krill-script-marco.test_compile",
                "title": "KST: test compile"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.106.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "eslint": "^9.36.0",
        "typescript": "^5.9.3",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2"
    }
}

