{
    "comments": {
        "lineComment": {
            "comment": "//",
            "noIndent": false
        },
        //"blockComment": ["/*", "*/"]
    },
    "brackets": [
        //["(", ")"],
        //["[", "]"],
        ["{", "}"]
    ],
    "autoClosingPairs": [
        //["(", ")"],
        //["[", "]"],
        ["{", "}"],
        ["'", "'"],
        ["\"", "\""],
        ["“", "”"]
    ],
    "surroundingPairs": [
        //["(", ")"],
        //["[", "]"],
        ["{", "}"],
        ["'", "'"],
        ["\"", "\""],
        ["“", "”"]
    ],
    "wordPattern": "(?u)(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s\\：“”]+)"
}