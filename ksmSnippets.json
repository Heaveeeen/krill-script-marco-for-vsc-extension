{
    "Character Declaration": {
        "prefix": ["char", "角色", "declare char"],
        "body": ["char ${0:id} \"${1:name}\""],
        "description": "Declare a new character"
    },
    "Clue Declaration": {
        "prefix": ["clue", "线索", "declare clue"],
        "body": ["clue ${0:id} \"${1:description}\" {", "\t${2:asks}", "}"],
        "description": "Declare a new clue"
    },
    "Dialog Declaration": {
        "prefix": ["dialog", "对话", "declare dialog"],
        "body": ["dialog ${0:id} {", "\t${1:commands}", "}"],
        "description": "Declare a new dialog"
    },
    "Combine": {
        "prefix": ["combine", "组合"],
        "body": ["combine {", "\t${0:reasons}", "} -> ${1:inference}"],
        "description": "Combine several clues to a new clue"
    },
    "Import": {
        "prefix": ["import", "导入"],
        "body": ["import \"${0:path}\""],
        "description": "Import another KSM file"
    },
    "Note": {
        "prefix": ["note", "笔记"],
        "body": ["note ${0:id}"],
        "description": "Note a clue or a char"
    }
}